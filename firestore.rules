rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deals are written only by the ingestion script (Admin SDK bypasses rules).
    match /regions/{fsa} {
      allow read: if request.auth != null;
      allow write: if false;
      match /deals/{dealId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    // Recipe library, seeded from web/src/data/recipes.json by .github/workflows/recipes.yml.
    match /recipes/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Shared household plans. The id is a long random string in the share link, so knowing
    // the link is the permission: anyone signed in may read or edit it, but nobody can list them.
    match /households/{id} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }
    // Each household (anonymous or signed-in user) owns its own preferences.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
