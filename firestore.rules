rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deals are written only by the ingestion script (Admin SDK bypasses rules).
    match /regions/{fsa} {
      allow read: if request.auth != null;
      allow write: if false;
      match /deals/{dealId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    // Each household (anonymous or signed-in user) owns its own preferences.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
