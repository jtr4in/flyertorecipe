# Apify API token (Console > Settings > Integrations). Never ship this to the web app.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
# Path to a Firebase service-account JSON (Project settings > Service accounts > Generate key)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Comma-separated postal codes to ingest. Deals are stored per FSA (first 3 characters).
POSTAL_CODES=M5V 2T6
# Cap deals per search term (actor max is 150). 20 x 30 staples ~= 600 deals ~= $1.20/run at $0.002/deal.
MAX_ITEMS_PER_QUERY=20
# Hard spending cap per actor run, in USD.
MAX_CHARGE_USD=2.00
# en-ca or fr-ca (fr-ca matches more in Quebec)
LOCALE=en-ca
